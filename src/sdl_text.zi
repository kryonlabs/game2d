// Game2D's text: white lettering the Sdl module tints when it draws it, a
// line of size N about N pixels tall. Pango and Cairo draw it on the
// desktop, the page's canvas in the browser.
#if OS == .WEB || #defined(PLATFORM_WEB) {
    using Backend :: #import "sdl_text_web";
} else {
    using Backend :: #import "sdl_text_pango";
}
