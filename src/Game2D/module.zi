// Backend-independent 2D geometry. Games use Kryon's public geometry values
// while the selected host owns drawing and input effects.
using Geometry :: #import "geometry";

#program_export
CircleContains :: (circle: Circle, point: Vector2) -> bool {
    if circle.radius < 0.0 { return false }
    dx: float32 = point.x - circle.center.x
    dy: float32 = point.y - circle.center.y
    return dx * dx + dy * dy <= circle.radius * circle.radius
}

#program_export
CirclesOverlap :: (first: Circle, second: Circle) -> bool {
    if first.radius < 0.0 || second.radius < 0.0 { return false }
    dx: float32 = first.center.x - second.center.x
    dy: float32 = first.center.y - second.center.y
    reach: float32 = first.radius + second.radius
    return dx * dx + dy * dy <= reach * reach
}

#program_export
RectanglesOverlap :: (first: Rectangle, second: Rectangle) -> bool {
    return first.width > 0.0 && first.height > 0.0 &&
        second.width > 0.0 && second.height > 0.0 &&
        first.x < second.x + second.width &&
        second.x < first.x + first.width &&
        first.y < second.y + second.height &&
        second.y < first.y + first.height
}
