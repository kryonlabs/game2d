// Null raylib host for Ziran games: a link-time stand-in for libraylib
// that lets the same Game2D Raylib adapter run without a window, GPU, or
// audio device. Drawing, input, textures, and audio are no-ops; the clock
// reads CLOCK_MONOTONIC, every frame advances by a fixed 1/60 s, and
// randomness comes from a seeded LCG (KASAIVAL_HEADLESS_SEED, default 1)
// so headless runs are reproducible. Generated from the Raylib adapter's
// foreign surface; the record types mirror the adapter's C ABI.
#import "c_string"
using Geometry :: #import "geometry";
using Drawing :: #import "drawing_props";

null_libc :: #system_library "libc";

NullTimespec :: struct {
    seconds: s64
    nanoseconds: s64
}

null_clock_gettime :: (clock_id: s32, tp: *NullTimespec) -> s32 #foreign null_libc "clock_gettime";
null_getenv :: (name: *u8) -> *u8 #foreign null_libc "getenv";
null_atoi :: (value: *u8) -> s32 #foreign null_libc "atoi";

NULL_CLOCK_MONOTONIC :: 1;

null_seed: u32;
null_seeded: bool;

null_ensure_seed :: () {
    if null_seeded { return }
    null_seeded = true
    null_seed = 1
    name: [32]u8
    if CopyCString("KASAIVAL_HEADLESS_SEED", name[:]) {
        value := null_getenv(*name[0])
        if value != null {
            parsed := null_atoi(value)
            if parsed > 0 {
                null_seed = cast(u32)parsed
            }
        }
    }
    if null_seed == 0 { null_seed = 1 }
}

#program_export
GetTime :: () -> float64 {
    tp: NullTimespec
    if null_clock_gettime(NULL_CLOCK_MONOTONIC, *tp) == 0 {
        return cast(float64)tp.seconds + cast(float64)tp.nanoseconds / 1000000000.0
    }
    return 0.0
}

#program_export
GetFrameTime :: () -> float32 {
    return 0.0166667
}

#program_export
SetRandomSeed :: (seed: u32) {
    null_seeded = true
    if seed != 0 {
        null_seed = seed
    } else {
        null_seed = 1
    }
}

#program_export
GetRandomValue :: (minimum: s32, maximum: s32) -> s32 {
    null_ensure_seed()
    if maximum <= minimum {
        return minimum
    }
    null_seed = null_seed * 1664525 + 1013904223
    span := null_seed % cast(u32)(maximum - minimum + 1)
    return minimum + cast(s32)span
}

#program_export
MeasureText :: (text: *u8, font_size: s32) -> s32 {
    length: s32 = 0
    while text[length] != cast(u8)0 {
        length += 1
    }
    if font_size > 0 {
        return length * (font_size / 2)
    }
    return length
}

#program_export
GetScreenWidth :: () -> s32 { return 640 }
#program_export
GetScreenHeight :: () -> s32 { return 480 }
#program_export
IsWindowReady :: () -> bool { return true }
#program_export
WindowShouldClose :: () -> bool { return false }
#program_export
IsAudioDeviceReady :: () -> bool { return false }
#program_export
IsSoundValid :: (sound: Sound) -> bool { unused sound; return false }
#program_export
IsMusicValid :: (music: Music) -> bool { unused music; return false }
#program_export
IsRenderTextureValid :: (target: RenderTexture2D) -> bool { unused target; return false }

AudioStream :: struct {
    buffer: *void
    processor: *void
    sample_rate: u32
    sample_size: u32
    channels: u32
}
Music :: struct {
    stream: AudioStream
    frame_count: u32
    looping: bool
    ctx_type: s32
    ctx_data: *void
}
RaylibImage :: struct {
    data: *void
    width: s32
    height: s32
    mipmaps: s32
    format: s32
}
RenderTexture2D :: struct {
    id: u32
    texture: Texture2D
    depth: Texture2D
}
Sound :: struct {
    stream: AudioStream
    frame_count: u32
}
Wave :: struct {
    frame_count: u32
    sample_rate: u32
    sample_size: u32
    channels: u32
    data: *void
}
NullEmptyMusic :: () -> Music {
    value: Music
    value.frame_count = 0
    value.looping = false
    value.ctx_type = 0
    value.ctx_data = null
    return value
}
NullEmptyRaylibImage :: () -> RaylibImage {
    value: RaylibImage
    value.data = null
    value.width = 0
    value.height = 0
    value.mipmaps = 0
    value.format = 0
    return value
}
NullEmptyRenderTexture2D :: () -> RenderTexture2D {
    value: RenderTexture2D
    value.id = 0
    return value
}
NullEmptySound :: () -> Sound {
    value: Sound
    value.frame_count = 0
    return value
}
NullEmptyTexture2D :: () -> Texture2D {
    value: Texture2D
    value.id = 0
    value.width = 0
    value.height = 0
    value.mipmaps = 0
    value.format = 0
    return value
}
NullEmptyWave :: () -> Wave {
    value: Wave
    value.frame_count = 0
    value.sample_rate = 0
    value.sample_size = 0
    value.channels = 0
    value.data = null
    return value
}
