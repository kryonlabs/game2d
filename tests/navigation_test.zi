#import "kryon/session"
#import "kryon/geometry"
#import "kryon/drawing_props"
#import "kryon/tree"
#import "kryon/Frame"
Paint :: #import "kryon/paint_queue"
#import "navigation"
#import "controls"
using FrameStatus;
Expect :: (ok: bool, message: string) -> bool {
    if !ok { print("Game2D local test failed: %\n", message) }
    return ok
}
// The stick test inspects committed paint without presenting it; these let
// native and portable builds resolve the host raster surface Box reaches.
#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
}
#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
}
Brightness :: (red: u8, green: u8, blue: u8) -> float32 {
    return (cast(float32)red * .2126 + cast(float32)green * .7152 +
        cast(float32)blue * .0722) / 255.0
}
#program_export
main :: () -> s32 {
    state: GameNavigation
    if !Expect(!GameNavigationPlay(*state) && state.page == GAME_CONTROLS, "first play asks for controls") { return 1 }
    if !Expect(!GameNavigationChoose(*state, 9) && !state.controls_selected, "reject unknown controls") { return 1 }
    if !Expect(GameNavigationChoose(*state, GAME_SWIPE) && state.page == GAME_PLAYING, "choice starts the pending game") { return 1 }
    GameNavigationPause(*state)
    GameNavigationControls(*state)
    if !Expect(!GameNavigationChoose(*state, GAME_PAD) && state.page == GAME_PAUSED, "changing controls preserves paused game") { return 1 }
    unused GameNavigationBack(*state)
    if !Expect(state.page == GAME_PLAYING, "Back resumes pause") { return 1 }
    GameNavigationHome(*state)
    GameNavigationSettings(*state)
    GameNavigationControls(*state)
    unused GameNavigationChoose(*state, GAME_SWIPE)
    unused GameNavigationBack(*state)
    if !Expect(state.page == GAME_TITLE && !GameNavigationBack(*state), "settings returns to title; title does not trap Back") { return 1 }
    swipe: GameSwipe
    if !Expect(GameSwipeDirection(*swipe, true, 20.0, 20.0) == -1 && swipe.active && !swipe.step && !swipe.moved && !swipe.tapped, "press does not invent movement") { return 1 }
    if !Expect(GameSwipeDirection(*swipe, true, 25.0, 25.0) == -1 && !swipe.step && !swipe.moved, "both axes below threshold ignore jitter") { return 1 }
    if !Expect(GameSwipeDirection(*swipe, true, 26.0, 20.0) == 2 && swipe.step && swipe.moved && !swipe.tapped, "exact threshold accepts first right step") { return 1 }
    if !Expect(GameSwipeDirection(*swipe, true, 32.0, 20.0) == 2 && swipe.step && swipe.x == 32.0, "same direction crossing after reanchor is another event") { return 1 }
    if !Expect(GameSwipeDirection(*swipe, true, 32.0, 22.0) == 2 && !swipe.step && swipe.moved, "held direction ignores jitter without repeating a step") { return 1 }
    if !Expect(GameSwipeDirection(*swipe, true, 32.0, 22.0) == 2 && !swipe.step, "stationary held frame has no event") { return 1 }
    if !Expect(GameSwipeDirection(*swipe, true, 32.0, 14.0) == 1 && swipe.step, "reanchor allows an upward corner") { return 1 }
    if !Expect(GameSwipeDirection(*swipe, true, 26.0, 14.0) == 0 && swipe.step, "left corner") { return 1 }
    if !Expect(GameSwipeDirection(*swipe, true, 26.0, 20.0) == 3 && swipe.step, "down corner") { return 1 }
    if !Expect(GameSwipeDirection(*swipe, false, 26.0, 20.0) == -1 && !swipe.active && !swipe.step && !swipe.moved && !swipe.tapped, "moved release stops movement without tapping") { return 1 }
    unused GameSwipeDirection(*swipe, true, 50.0, 50.0)
    unused GameSwipeDirection(*swipe, true, 55.0, 54.0)
    if !Expect(GameSwipeDirection(*swipe, false, 55.0, 54.0) == -1 && swipe.tapped && !swipe.step, "subthreshold release is a tap without movement") { return 1 }
    unused GameSwipeDirection(*swipe, false, 55.0, 54.0)
    if !Expect(!swipe.tapped && !swipe.step, "release events last one sample") { return 1 }
    unused GameSwipeDirection(*swipe, true, 10.0, 10.0)
    swipe = GameSwipe.{}
    unused GameSwipeDirection(*swipe, false, 10.0, 10.0)
    if !Expect(!swipe.tapped && !swipe.step && !swipe.active, "cancel discards a possible tap") { return 1 }
    unused GameSwipeDirection(*swipe, true, 0.0, 0.0)
    unused GameSwipeDirection(*swipe, true, 6.0, 0.0)
    unused GameNavigationPlay(*state)
    GameNavigationPause(*state)
    if !Expect(state.page == GAME_PAUSED, "navigation leaves play before input reset") { return 1 }
    swipe = GameSwipe.{}
    GameNavigationResume(*state)
    if !Expect(GameSwipeDirection(*swipe, true, 100.0, 100.0) == -1 && !swipe.step && !swipe.moved, "navigation reset starts a fresh anchor without a stale step") { return 1 }
    if !Expect(GameSwipeDirection(*swipe, true, 106.0, 106.0, 0.0) == 2 && swipe.step, "default threshold fallback and horizontal tie break") { return 1 }
    unused GameSwipeDirection(*swipe, false, 106.0, 106.0)
    unused GameSwipeDirection(*swipe, true, 0.0, 0.0, 12.0)
    if !Expect(GameSwipeDirection(*swipe, true, 11.0, 0.0, 12.0) == -1 && !swipe.step, "caller threshold suppresses smaller movements") { return 1 }
    if !Expect(GameSwipeDirection(*swipe, true, 12.0, 0.0, 12.0) == 2 && swipe.step, "caller threshold accepts exact crossing") { return 1 }
    stick: GameStick
    if !Expect(!GameStickIndicatorPlace(stick, 0.0, 0.0).visible, "no indicator without a press") { return 1 }
    if !Expect(!GameStickSteer(*stick, true, 100.0, 100.0).steering, "a press alone does not steer") { return 1 }
    if !Expect(!GameStickSteer(*stick, true, 104.0, 103.0).steering, "jitter inside the dead zone does not steer") { return 1 }
    lean := GameStickSteer(*stick, true, 118.0, 124.0)
    if !Expect(lean.steering && lean.x > .59 && lean.x < .61 && lean.y > .79 && lean.y < .81, "steers in any direction") { return 1 }
    layout := GameStickIndicatorPlace(stick, lean.x, lean.y, 30.0)
    if !Expect(layout.visible && layout.ring.x == 70.0 && layout.ring.width == 60.0, "ring stays where the press began") { return 1 }
    if !Expect(layout.finger.x < 118.0 && layout.finger.x + layout.finger.width > 118.0, "dot follows the finger") { return 1 }
    if !Expect(layout.pip.x > 110.0 && layout.pip.y > 115.0, "pip points down and right") { return 1 }
    preview := GameSwipePreviewPlace(Rectangle.{100.0, 50.0, 160.0, 120.0}, 0.0)
    turned := GameSwipePreviewPlace(Rectangle.{100.0, 50.0, 160.0, 120.0}, 1.0)
    if !Expect(preview.visible && preview.ring.x >= 100.0 && preview.ring.y >= 50.0 &&
        preview.ring.x + preview.ring.width <= 260.0 && preview.ring.y + preview.ring.height <= 170.0,
        "swipe preview stays in its card") { return 1 }
    if !Expect(preview.finger.x != turned.finger.x || preview.finger.y != turned.finger.y,
        "swipe preview shows movement") { return 1 }
    unused GameStickSteer(*stick, true, 200.0, 100.0)
    if !Expect(stick.start_x == 152.0 && stick.start_y == 100.0, "a far finger drags the anchor") { return 1 }
    back := GameStickSteer(*stick, true, 140.0, 100.0)
    if !Expect(back.steering && back.x == -1.0, "turning back answers at once") { return 1 }
    if !Expect(!GameStickSteer(*stick, false, 0.0, 0.0).tapped, "a steered release is not a tap") { return 1 }
    unused GameStickSteer(*stick, true, 50.0, 50.0)
    if !Expect(GameStickSteer(*stick, false, 50.0, 50.0).tapped, "a still release is a tap") { return 1 }
    render_stick: GameStick
    unused GameStickSteer(*render_stick, true, 120.0, 140.0)
    held := GameStickSteer(*render_stick, true, 138.0, 144.0)
    session := SessionOpen()
    if !Expect(SessionValid(session), "opens a headless paint session") { return 1 }
    defer { unused SessionClose(session) }
    held_status := BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 400.0, 400.0})
    if !Expect(held_status == cast(FrameStatus)FrameOk,
        "begins a headless paint frame") { return 1 }
    GameStickIndicator(session, cast(u64)52020, render_stick, held.x, held.y)
    if !Expect(CommitFrame(session) == cast(FrameStatus)FrameOk,
        "commits the held paint frame") { return 1 }
    paint_count := Paint.PendingPaintCount(session)
    if !Expect(paint_count == 6, "draws backing, rim and outlined markers") { return 1 }
    rim := Paint.PendingPaintAt(session, 0)
    backing := Paint.PendingPaintAt(session, 1)
    pip := Paint.PendingPaintAt(session, 2)
    pip_center := Paint.PendingPaintAt(session, 3)
    finger := Paint.PendingPaintAt(session, 4)
    finger_center := Paint.PendingPaintAt(session, 5)
    rim_thickness := (rim.bounds.width - backing.bounds.width) * .5
    if !Expect(rim.bounds.width == 80.0 && rim_thickness == 3.0,
        "uses a larger ring with a thick rim") { return 1 }
    if !Expect(Brightness(backing.color.r, backing.color.g, backing.color.b) < .25 &&
        Brightness(rim.color.r, rim.color.g, rim.color.b) > .80 &&
        backing.color.a > 200 && rim.color.a > 230,
        "backing keeps a strong contrast with the rim") { return 1 }
    if !Expect(finger.bounds.width >= 24.0 && pip.bounds.width >= 20.0,
        "markers are large enough to see") { return 1 }
    if !Expect(Brightness(finger_center.color.r, finger_center.color.g, finger_center.color.b) < .25 &&
        Brightness(pip_center.color.r, pip_center.color.g, pip_center.color.b) < .25 &&
        Brightness(finger.color.r, finger.color.g, finger.color.b) > .80 &&
        Brightness(pip.color.r, pip.color.g, pip.color.b) > .80,
        "markers keep dark centers and bright outlines") { return 1 }
    if !Expect(rim.kind == cast(s32)Paint.PaintKind.PaintKindRoundedFill &&
        backing.kind == cast(s32)Paint.PaintKind.PaintKindRoundedFill &&
        finger.kind == cast(s32)Paint.PaintKind.PaintKindRoundedFill &&
        finger_center.kind == cast(s32)Paint.PaintKind.PaintKindRoundedFill,
        "paint commands are layered filled circles") { return 1 }
    Paint.PaintClear(session)
    unused GameStickSteer(*render_stick, false, 138.0, 144.0)
    released_status := BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 400.0, 400.0})
    if !Expect(released_status == cast(FrameStatus)FrameOk,
        "begins the released paint frame") { return 1 }
    GameStickIndicator(session, cast(u64)52020, render_stick, held.x, held.y)
    if !Expect(CommitFrame(session) == cast(FrameStatus)FrameOk,
        "commits the released paint frame") { return 1 }
    if !Expect(Paint.PendingPaintCount(session) == 0, "release hides the indicator") { return 1 }
    Paint.PaintClear(session)
    print("Game2D local navigation/control tests passed.\n")
    return 0
}
