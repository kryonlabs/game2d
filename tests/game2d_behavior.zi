using Game :: #import "Game2D";

#program_export
main :: () -> s32 {
    center: Vector2 = Vector2.{10.0, 10.0}
    circle: Circle = Circle.{center, 5.0}
    if !CircleContains(circle, Vector2.{13.0, 14.0}) { return 1 }
    if CircleContains(circle, Vector2.{16.0, 10.0}) { return 2 }
    if !CirclesOverlap(circle, Circle.{Vector2.{20.0, 10.0}, 5.0}) { return 3 }
    if !RectanglesOverlap(Rectangle.{0.0, 0.0, 10.0, 10.0},
        Rectangle.{9.0, 9.0, 10.0, 10.0}) { return 4 }
    if RectanglesOverlap(Rectangle.{0.0, 0.0, 10.0, 10.0},
        Rectangle.{10.0, 10.0, 10.0, 10.0}) { return 5 }
    return 0
}
